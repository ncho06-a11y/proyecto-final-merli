# ---------------------------------------------------------------
# .gitignore del proyecto final - Programación Analítica II
# ---------------------------------------------------------------

# Entorno virtual: se reconstruye con pip install -r requirements.txt
.venv/
venv/
env/

# Archivos que genera Python solo
__pycache__/
*.py[cod]

# Copias de respaldo de Jupyter
.ipynb_checkpoints/

# Datos: los CSV de datos/ SÍ se suben, porque el notebook lee directamente
# de esa carpeta y sin ellos no se puede ejecutar. Son datos sintéticos
# (ver datos/Info.txt) y pesan poco.

# Credenciales y secretos: NUNCA al repositorio
.env
*.key
*.pem
credenciales*
token*

# Salidas: los gráficos de salidas/ SÍ se suben, porque son parte del informe.
*.log

# Basura del sistema operativo y de los editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
